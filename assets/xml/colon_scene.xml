<mujoco model="colon_model">
  
  <compiler meshdir="../meshes" texturedir="../texture"/>
  <option timestep="0.005" gravity="0 0 0" />

  <visual>
    <headlight active="0"/>
    <quality shadowsize="0"/>
    <map fogstart="0" fogend="0.1" znear="0.0005"/>
    <global offwidth="2048" offheight="2048"/>
  </visual>

  <asset>
    <mesh name="colon_mesh" file="model.obj" scale="0.01 0.01 0.01"/>
    <texture name="colon_tex" type="2d" file="colon_texture.png"/>
    <texture name="floor_tex" type="2d" builtin="checker" width="64" height="64" rgb1="1 1 1" rgb2="0 0 0"/>
    
    <material name="colon_material" texture="colon_tex" specular="0.2" shininess="0.9" reflectance="0"/>
    <material name="floor_mat" texture="floor_tex" specular="0.05" shininess="0.05"/>
  </asset>

  <worldbody>
    <geom name="floor" type="plane" size="32 32 0.001" material="floor_mat" 
          pos="0 0 -3.0" contype="0" conaffinity="0"/>
    
    <geom name="colon_geom" type="mesh" mesh="colon_mesh" material="colon_material" 
          contype="0" conaffinity="0"/>

    <body name="camera_rig" mocap="true" pos="0 0 0" euler="130 -30 90">
      <geom name="rig_tip" type="sphere" size="0.004" rgba="0 1 0 1" pos="0 0 0"/>
      <geom name="rig_handle" type="capsule" size="0.004" fromto="0 0 0.01 0 0 0.05" rgba="1 0 0 1"/>
      
      <camera name="endoscope_cam" pos="0 0 0" mode="fixed" fovy="120"/>
      
      <light pos="0 0 0" dir="0 0 -1" 
             cutoff="100" exponent="30" 
             attenuation="0 0 80" 
             diffuse="10 10 10" specular="5 5 5"/>
    </body>
  </worldbody>

</mujoco>